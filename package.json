{
  "name": "song-adventskalender",
  "private": true,
  "version": "2.0.0",
  "description": "Fully static, single-page song advent calendar — 100% client-side.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "fonts": "node scripts/subset-fonts.mjs",
    "doors": "node scripts/process-doors.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
